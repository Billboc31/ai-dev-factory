# Local environment configuration (host-specific paths and secrets) —
# never committed. Copy deploy/.env.example to deploy/.env to bootstrap.
.env
deploy/.env

# Runtime clone sentinel (created manually in runtime clones, never in human clones)
.ai-dev-factory-runtime

runs/*/state.json
runs/*/state.json.tmp
runs/*/runtime.log
runs/*/retry-state.json
runs/*/retry-state.json.tmp
runs/.issue-intake.json
runs/.issue-intake.json.tmp
runs/workers.json
runs/workers.json.tmp
# SQLite runtime DB
.runtime/
*.sqlite
*.sqlite-wal
*.sqlite-shm
__pycache__/
*.py[cod]
.venv/
apps/dashboard/node_modules/
# daemon runtime
runs/daemon.pid
runs/daemon.log
runs/*/workflow-status.md
runs/*/daemon.lock
__pycache__/
*.pyc

runs/daemon.log
runs/*/runtime.log
runs/runtime.log
runs/daemon.pid

# Frontend/runtime caches
node_modules/
apps/dashboard/node_modules/
.vite/
apps/dashboard/.vite/
.pytest_cache/

# Frontend/runtime/test caches
node_modules/
apps/dashboard/node_modules/
.vite/
apps/dashboard/.vite/
.pytest_cache/
**/.pytest_cache/

# Generated / local caches
node_modules/
.pytest_cache/
apps/dashboard/node_modules/
apps/dashboard/.pytest_cache/

# Python cache
__pycache__/
*.pyc

# Runtime generated files
runs/**/runtime.log
runs/daemon.log
runs/daemon.pid
runs/.project-map*.json
runs/.issue-intake.json

# Python cache
__pycache__/
*.pyc

# Runtime generated files
runs/**/runtime.log
runs/daemon.log
runs/daemon.pid
runs/.project-map*.json
runs/.issue-intake.json
runtime/*.sqlite-wal

# Postgres-backed runtime: PgHandle.__str__ renders as `postgres:adf#<project>`.
# When test fixtures don't fully patch the backend resolver, that string can
# leak into sqlite3.connect() and create a file in CWD — block at the source.
postgres:adf#*
